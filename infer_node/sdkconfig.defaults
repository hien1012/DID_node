# TTGO T8 V1.7 (ESP32-WROVER-B: 4 MB flash, 8 MB PSRAM of which 4 MB is mapped).
# Based on ../sdkconfig.defaults + ../sdkconfig.camera.defaults (verified on this board),
# plus the inference settings of DID_NODE/infer_node/sdkconfig.defaults.
# After editing this file delete infer_node/sdkconfig so it is applied.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# 80 MHz flash + 80 MHz PSRAM, same as DID_CAM_SEAN/FD_did_cam_v4 on this board (and the
# esp32-camera README). The cam CNN is memory-bound (arena in PSRAM, FC weights in flash):
# FD_v4 ran the same model in about half the invoke time at 80/80, even with -Og and
# reference kernels. On the ESP32, PSRAM 80 MHz requires flash 80 MHz.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# This board's chip: ESP32-D0WD v3.1 (ECO4). Requiring >= v3.0 removes the rev0/1
# PSRAM cache workaround (SPIRAM_CACHE_WORKAROUND: a memw after every memory access,
# compiled into all code); with it on, the cam CNN took ~930 ms, dominated by
# per-element cost. Chips older than v3.0 refuse to boot this firmware.
CONFIG_ESP32_REV_MIN_3=y

# -O2 (Performance). tflite-micro then adds its upstream -O3 (depthwise_conv.cc -O2),
# esp-nn follows the project. For debugging use CONFIG_COMPILER_OPTIMIZATION_DEFAULT=y (-Og).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# PSRAM: camera fb (8 x 300 KB), TFLM arena, FD buffers, audio windows.
# 80 MHz (see the flash frequency above); the recording firmware uses 40 MHz.
# 80 MHz makes PSRAM occupy the VSPI host; SD is SDMMC and the camera I2S0, so no conflict.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_80M=y
# Plain malloc() above 4 KB goes to PSRAM so internal RAM is not fragmented;
# DMA buffers request MALLOC_CAP_DMA / MALLOC_CAP_INTERNAL explicitly.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Per-task CPU time, see main/task_usage.c. Clock defaults to esp_timer (1 us).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# cam_task on Core 1 with camera_capture / cam_detect; Core 0 has Wi-Fi, CNN, SD writes.
CONFIG_CAMERA_CORE1=y
CONFIG_CAMERA_TASK_STACK_SIZE=4096
# cam_task's VSYNC handling (finish frame, restart DMA) runs from IRAM (local driver option):
# from flash, cache misses caused by FD on the same core and the CNN on the shared
# flash/PSRAM bus delay the DMA restart and the first lines are lost (incomplete frames).
CONFIG_CAMERA_TASK_IRAM=y
# Same DMA buffer size as the recording firmware (verified without FB-SIZE drops).
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=32768

# Upload-oriented network profile. Dynamic Wi-Fi TX buffers are unavailable with
# SPIRAM_USE_MALLOC in IDF 5.1. With TRY_ALLOCATE_WIFI_LWIP the TX buffers prefer PSRAM;
# the RX side only carries TCP ACKs and short JSON replies, so it is kept small
# (RX buffers are internal DMA RAM).
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=64
# RX: static >= RX_BA_WIN, dynamic >= static (IDF Kconfig requirements).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# Kept off from the PSRAM cache workaround era (it placed libc in IRAM and these two
# overflowed iram0_0_seg, see ../sdkconfig.camera.defaults). With REV_MIN_3 the
# workaround is gone; these could be re-evaluated, but stay off until measured.
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
