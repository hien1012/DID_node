digraph AudioNodeFlow {
    graph [rankdir=TB, bgcolor="#F8FAFC", pad="0.3", nodesep="0.3", ranksep="0.55", splines=polyline, fontname="Microsoft JhengHei", fontsize=20, label="ESP32 Audio Node Flow", labelloc=t]
    node [shape=box, style="rounded,filled", fontname="Microsoft JhengHei", fontsize=11, color="#475569", fillcolor="#FFFFFF", fontcolor="#0F172A", margin="0.16,0.10"]
    edge [fontname="Microsoft JhengHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7]

    subgraph cluster_boot {
        label="app_main.c - boot and common services"
        color="#94A3B8"; style="rounded,dashed"
        start [label="Power on\ninit_nvs()", fillcolor="#E2E8F0"]
        identity [label="device_identity_init()\nAudio device ID", fillcolor="#E2E8F0"]
        wifi [label="wifi_manager_init()\nwait up to 15 s, retry", shape=diamond, fillcolor="#FEF3C7", color="#D97706"]
        time [label="time_sync_configure_timezone()\n/time sync until valid", fillcolor="#FEF3C7", color="#D97706"]
        init [label="audio_record_init()\nhealth_monitor_start()", fillcolor="#E0F2FE", color="#0284C7"]
        start -> identity -> wifi -> time -> init
    }

    subgraph cluster_backlog {
        label="Boot backlog"
        color="#D97706"; style="rounded"
        scan [label="storage_count_done()\nAny /sdcard/done files?", shape=diamond, fillcolor="#FEF3C7", color="#D97706"]
        backlog [label="upload_process_pending()\noldest done file first", fillcolor="#DBEAFE", color="#2563EB"]
        retry [label="Upload failed\nwait 10 s and retry", fillcolor="#FEE2E2", color="#DC2626"]
        ready [label="Enter scheduled loop", fillcolor="#DCFCE7", color="#16A34A"]
        scan -> backlog [label="yes"]
        scan -> ready [label="no"]
        backlog -> scan [label="all uploaded"]
        backlog -> retry [label="Wi-Fi/server/ACK error"]
        retry -> backlog
    }
    init -> scan

    subgraph cluster_record {
        label="Scheduled recording: 5 min every 10 min"
        color="#0EA5E9"; style="rounded"
        cycle [label="Cycle starts\nAPP_RECORD_PERIOD_MS", fillcolor="#F1F5F9"]
        once [label="audio_record_once()", fillcolor="#E0F2FE", color="#0284C7"]
        capture [label="capture_task\nI2S DMA read -> int32 buffer\nconvert to int16 PCM", fillcolor="#E0F2FE", color="#0284C7"]
        queue [label="q_full_blocks\n16-block pool, 1024 samples/block\nq_free_blocks returns buffers", shape=parallelogram, fillcolor="#DBEAFE", color="#2563EB"]
        writer [label="writer_task\nwrite WAV header + PCM\nfinalize header on completion", fillcolor="#E0F2FE", color="#0284C7"]
        undone [label="/sdcard/undone/YYYYMMDD_HHMMSS.wav\nrecording in progress or failed", shape=folder, fillcolor="#FFF7ED", color="#EA580C"]
        done [label="storage_finish_recording(commit)\nrename undone -> done", shape=folder, fillcolor="#DCFCE7", color="#16A34A"]
        cycle -> once -> capture -> queue -> writer -> undone -> done
    }
    ready -> cycle

    subgraph cluster_upload {
        label="Per-cycle upload"
        color="#2563EB"; style="rounded"
        check [label="wifi_manager_wait_connected(15 s)", shape=diamond, fillcolor="#E0E7FF", color="#4F46E5"]
        upload [label="POST /upload/audio\nstream WAV in 4 KB chunks\nheaders: device, capture, time, size", fillcolor="#DBEAFE", color="#2563EB"]
        ack [label="HTTP 200 + ACK valid?\nstatus + capture_id + bytes", shape=diamond, fillcolor="#E0E7FF", color="#4F46E5"]
        delete [label="storage_delete_done()\nremove local WAV", fillcolor="#DCFCE7", color="#16A34A"]
        keep [label="Keep done file\nretry on a later cycle", fillcolor="#FEE2E2", color="#DC2626"]
        wait [label="Wait remaining period\nthen next cycle", fillcolor="#F1F5F9"]
        done -> check
        check -> upload [label="connected"]
        check -> keep [label="offline"]
        upload -> ack
        ack -> delete [label="yes"]
        ack -> keep [label="no / timeout"]
        delete -> upload [label="more done files", constraint=false]
        delete -> wait [label="none left"]
        keep -> wait
        wait -> cycle
    }

    subgraph cluster_health {
        label="Independent health task"
        color="#14B8A6"; style="rounded,dashed"
        health [label="health_monitor_start()\nperiodic heartbeat every 1 min", fillcolor="#CCFBF1", color="#0F766E"]
        heartbeat [label="POST /heartbeat\nWi-Fi, heap, SD, pending files,\nrecord/upload counters", fillcolor="#CCFBF1", color="#0F766E"]
        health -> heartbeat -> health [label="next period"]
    }
    init -> health [style=dashed, label="starts task"]

    server [label="Flask server.py\n/upload/audio validates WAV + headers\nstore file + DB record\nreturn ACK JSON", shape=component, fillcolor="#F1F5F9"]
    upload -> server [color="#2563EB"]
    server -> ack [color="#16A34A", label="ACK"]
    heartbeat -> server [color="#0F766E", label="/heartbeat"]
}