digraph CameraNodeFlow {
    graph [rankdir=TB, bgcolor="#F8FAFC", pad="0.3", nodesep="0.3", ranksep="0.55", splines=polyline, fontname="Microsoft JhengHei", fontsize=20, label="ESP32 Camera Node Flow", labelloc=t]
    node [shape=box, style="rounded,filled", fontname="Microsoft JhengHei", fontsize=11, color="#475569", fillcolor="#FFFFFF", fontcolor="#0F172A", margin="0.16,0.10"]
    edge [fontname="Microsoft JhengHei", fontsize=9, color="#64748B", fontcolor="#334155", arrowsize=0.7]

    subgraph cluster_boot {
        label="cam_app_main.c - boot and common services"
        color="#94A3B8"; style="rounded,dashed"
        start [label="Power on\ninit_nvs()", fillcolor="#E2E8F0"]
        identity [label="device_identity_init()\nCamera device ID", fillcolor="#E2E8F0"]
        wifi [label="wifi_manager_init()\nwait up to 15 s, retry", shape=diamond, fillcolor="#FEF3C7", color="#D97706"]
        time [label="time_sync_configure_timezone()\n/time sync until valid", fillcolor="#FEF3C7", color="#D97706"]
        storage [label="cam_storage_init()\nmount SD + create cam_undone/cam_done", fillcolor="#F3E8FF", color="#7C3AED"]
        health [label="cam_health_monitor_start()\nindependent heartbeat task", fillcolor="#CCFBF1", color="#0F766E"]
        start -> identity -> wifi -> time -> storage -> health
    }

    subgraph cluster_backlog {
        label="Boot camera backlog"
        color="#D97706"; style="rounded"
        scan [label="cam_storage_count_done()\nAny /sdcard/cam_done files?", shape=diamond, fillcolor="#FEF3C7", color="#D97706"]
        backlog [label="cam_upload_process_pending()\noldest RAW file first", fillcolor="#EDE9FE", color="#7C3AED"]
        retry [label="Upload failed\nwait 10 s and retry", fillcolor="#FEE2E2", color="#DC2626"]
        init [label="cam_record_init()\ncamera + capture/writer pipeline", fillcolor="#F3E8FF", color="#7C3AED"]
        scan -> backlog [label="yes"]
        scan -> init [label="no"]
        backlog -> scan [label="all uploaded"]
        backlog -> retry [label="Wi-Fi/server/ACK error"]
        retry -> backlog
    }
    health -> scan

    subgraph cluster_record {
        label="Scheduled recording: 10 sec every 5 min"
        color="#8B5CF6"; style="rounded"
        cycle [label="Cycle starts\nCAM_RECORD_PERIOD_MS", fillcolor="#F1F5F9"]
        once [label="cam_record_once()", fillcolor="#F3E8FF", color="#7C3AED"]
        reserve [label="cam_storage_begin_recording()\npreallocate RAW file", fillcolor="#FFF7ED", color="#EA580C"]
        capture [label="capture_task - Core 1\nDVP DMA -> PSRAM framebuffer\nwarm-up / frame validation", fillcolor="#F3E8FF", color="#7C3AED"]
        queue [label="ready frame queue\nzero-copy framebuffer pointers\nno pixel copy into queue", shape=parallelogram, fillcolor="#EDE9FE", color="#7C3AED"]
        writer [label="writer_task - Core 0\ncopy PSRAM -> 32 KB internal DMA buffer\nwrite() to SD in chunks", fillcolor="#F3E8FF", color="#7C3AED"]
        undone [label="/sdcard/cam_undone/YYYYMMDD_HHMMSS.raw\nrecording in progress or failed", shape=folder, fillcolor="#FFF7ED", color="#EA580C"]
        commit [label="frame / FPS quality check\ncam_storage_finish_recording()", shape=diamond, fillcolor="#E0E7FF", color="#4F46E5"]
        done [label="rename undone -> done\nGRAY8 640x480, target 5 FPS", shape=folder, fillcolor="#DCFCE7", color="#16A34A"]
        failed [label="Keep cam_undone\nrecording marked failed", shape=folder, fillcolor="#FEE2E2", color="#DC2626"]
        init -> cycle
        cycle -> once -> reserve -> capture -> queue -> writer -> undone -> commit
        commit -> done [label="pass"]
        commit -> failed [label="fail / dropped frames"]
    }

    subgraph cluster_upload {
        label="Per-cycle upload"
        color="#7C3AED"; style="rounded"
        check [label="wifi_manager_wait_connected(15 s)", shape=diamond, fillcolor="#E0E7FF", color="#4F46E5"]
        upload [label="POST /upload/video\nstream RAW in 4 KB chunks\nheaders: size, frames, width, height, FPS", fillcolor="#EDE9FE", color="#7C3AED"]
        ack [label="HTTP 200 + ACK valid?\nstatus + capture_id + bytes", shape=diamond, fillcolor="#E0E7FF", color="#4F46E5"]
        delete [label="cam_storage_delete_done()\nremove local RAW", fillcolor="#DCFCE7", color="#16A34A"]
        keep [label="Keep cam_done file\nretry on a later cycle", fillcolor="#FEE2E2", color="#DC2626"]
        wait [label="Wait remaining period\nthen next cycle", fillcolor="#F1F5F9"]
        done -> check
        check -> upload [label="connected"]
        check -> keep [label="offline"]
        upload -> ack
        ack -> delete [label="yes"]
        ack -> keep [label="no / timeout"]
        delete -> upload [label="more cam_done files", constraint=false]
        delete -> wait [label="none left"]
        keep -> wait
        failed -> wait [label="skip upload"]
        wait -> cycle
    }

    subgraph cluster_monitor {
        label="Independent camera health task"
        color="#14B8A6"; style="rounded,dashed"
        monitor [label="Collect Wi-Fi, heap, PSRAM, SD,\npending files, frame drops, upload stats", fillcolor="#CCFBF1", color="#0F766E"]
        heartbeat [label="POST /heartbeat\nnode_type=camera", fillcolor="#CCFBF1", color="#0F766E"]
        monitor -> heartbeat -> monitor [label="next period"]
    }
    health -> monitor [style=dashed, label="starts task"]

    server [label="Flask server.py\n/upload/video validates GRAY8 metadata\nstore RAW / convert to video / DB\nreturn ACK JSON", shape=component, fillcolor="#F1F5F9"]
    upload -> server [color="#7C3AED"]
    server -> ack [color="#16A34A", label="ACK"]
    heartbeat -> server [color="#0F766E", label="/heartbeat"]
}