# TTGO T8 (ESP32-WROVER): 4 MB flash + PSRAM. Camera frame buffers (8 x 300 KB)
# live in PSRAM, and the camera app is larger than the default 1 MB factory
# partition, so use the 1.5 MB single-app table.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_40M=y
# Let Wi-Fi / LWIP allocate from PSRAM first, so 64 static TX buffers
# (~100 KB) do not exhaust internal RAM needed by camera and SD DMA.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Camera upload throughput profile from iperf, adjusted for PSRAM.
# Dynamic Wi-Fi TX buffers are unavailable with SPIRAM_USE_MALLOC in IDF 5.1.
# TX side is at Kconfig maximums; shared LWIP TX settings are in sdkconfig.defaults.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=128
# PSRAM cache workaround already places libc in IRAM; LWIP IRAM optimization
# (~10 KB) overflows iram0_0_seg by ~5.5 KB, so camera keeps it off.
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
# Wi-Fi RX path only carries TCP ACKs during upload; free its IRAM (~17 KB).
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
