     while (1) {
         xQueueReceive(cam_obj->event_queue, (void *)&cam_event, portMAX_DELAY);
+        if (cam_event == CAM_PAUSE_EVENT) {
+            /* The caller has disabled VSYNC and DMA. Recycle the partial frame
